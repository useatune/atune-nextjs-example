# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (dashboard.clerk.com -> your app -> API keys) ---
# Enable Organizations in the Clerk dashboard: an organization is the customer account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: only needed for the identity webhook (app/api/webhooks/clerk/route.ts).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Atune (Atune -> Settings -> API key) ---
# Server-side only. Never prefix it with NEXT_PUBLIC_, never paste it into an AI chat.
ATUNE_API_KEY=
# The bare host, no path. The SDK adds /api/v1/... itself. Set it explicitly.
ATUNE_URL=https://useatune.com
# Set to true only after you have accepted Atune's data-processing agreement (DPA).
# It turns on identify()/group() (names, emails, company names) in the Clerk webhook.
ATUNE_SEND_IDENTITY=false
